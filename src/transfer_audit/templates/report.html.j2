<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --text: #1a1a1a;
    --muted: #5c5c5c;
    --rule: #d6d6d6;
    --bg: #fafafa;
    --card: #ffffff;
    --ask: #111111;
    --satisfied: #1b7f4e;
    --violated: #b42318;
    --unknown: #9a6700;
    --na: #667085;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font: 17px/1.5 "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  }
  main {
    max-width: 920px;
    margin: 0 auto;
    padding: 40px 28px 80px;
  }
  h1 { font-size: 28px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 8px; }
  h2 { font-size: 20px; font-weight: 600; margin: 40px 0 12px; }
  h3 { font-size: 16px; font-weight: 600; margin: 0 0 8px; }
  p { margin: 0 0 12px; }
  .muted { color: var(--muted); font-size: 14px; }
  .claim { font-size: 18px; margin: 16px 0 28px; }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 24px 0 8px;
  }
  .metric { padding: 8px 0; }
  .metric .n {
    display: block;
    font-size: 40px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .metric .lbl { display: block; color: var(--muted); font-size: 13px; margin-top: 4px; }
  .worked {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 28px 0;
    margin: 8px 0 8px;
  }
  .worked ol { margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .worked li { counter-increment: step; margin: 0 0 22px; }
  .worked li:last-child { margin-bottom: 0; }
  .worked .kicker {
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .worked .kicker::before { content: counter(step) " · "; }
  .worked .ask {
    font-size: 26px;
    line-height: 1.25;
    font-weight: 600;
    color: var(--ask);
  }
  .worked blockquote {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
  }
  .objects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 12px 0;
  }
  .object {
    background: var(--card);
    border: 1px solid var(--rule);
    padding: 16px;
  }
  .object .obj { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
  .object .disc { color: var(--muted); font-size: 13px; margin-top: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .entry {
    border-top: 1px solid var(--rule);
    padding: 20px 0;
  }
  .entry-head { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; margin-bottom: 8px; }
  .status {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .status.SATISFIED { color: var(--satisfied); }
  .status.VIOLATED { color: var(--violated); }
  .status.UNKNOWN { color: var(--unknown); }
  .status.NA { color: var(--na); }
  .doc { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 13px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 12px 0; }
  .pair h4 { margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .pair p, .ask-block p { margin: 0; font-size: 16px; }
  .ask-block { margin-top: 12px; }
  .ask-block p { font-size: 20px; font-weight: 600; line-height: 1.3; }
  .meta { font-size: 13px; color: var(--muted); margin-top: 10px; }
  @media (max-width: 720px) {
    .metrics, .objects, .pair { grid-template-columns: 1fr; }
    .worked .ask { font-size: 22px; }
  }
</style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  {% if context %}
  <p class="claim">{{ context.target_claim }}</p>
  {% endif %}

  {% if worked %}
  <section class="worked">
    <h2 style="margin-top:0">Why this is the question</h2>
    <p class="muted">{{ worked.axis }}{% if worked.subtype %} · {{ worked.subtype }}{% endif %} · {{ worked.source_doc_id }}</p>
    <ol>
      <li>
        <div class="kicker">What the source result depends on</div>
        <blockquote>{{ worked.source_assumption }}</blockquote>
      </li>
      <li>
        <div class="kicker">What that becomes in the target system</div>
        <blockquote>{{ worked.target_restatement or "The target description does not yet restate this condition." }}</blockquote>
      </li>
      <li>
        <div class="kicker">Therefore, what to ask</div>
        <div class="ask">{{ worked.what_would_resolve_it or worked.rationale }}</div>
      </li>
    </ol>
  </section>
  {% endif %}

  <div class="metrics">
    <div class="metric"><span class="n">{{ metrics.n_entries }}</span><span class="lbl">ledger entries</span></div>
    <div class="metric"><span class="n">{{ metrics.unknown }} / {{ metrics.n_entries }}</span><span class="lbl">UNKNOWN</span></div>
    <div class="metric"><span class="n">{{ metrics.n_axes }}</span><span class="lbl">axes with an entry</span></div>
    <div class="metric"><span class="n">{{ metrics.extracted }}</span><span class="lbl">papers extracted{% if metrics.held %} · {{ metrics.held }} held out{% endif %}</span></div>
  </div>

  {% if break_points %}
  <h2>Break points</h2>
  <p class="muted">Unmapped slots among extracted papers. Denominator is n={{ extracted_n }} in every cell. Do not read a count as a literature rate.</p>
  <table>
    <thead>
      <tr><th>Slot</th><th>Stating it / n={{ extracted_n }}</th><th>Target</th></tr>
    </thead>
    <tbody>
      {% for bp in break_points %}
      <tr>
        <td>{{ bp.slot }}</td>
        <td class="num">{{ bp.papers_stating }} / n={{ extracted_n }}</td>
        <td>{% if bp.target_states_it %}stated{% else %}silent{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if slot_objects %}
  <h2>Same slot, different ontology</h2>
  <p class="muted">isolation_unit is the unit across which independence is assumed. Structure preserved; the object is not.</p>
  <div class="objects">
    {% for obj in slot_objects %}
    <div class="object">
      <div class="obj">{{ obj.object }}</div>
      <div class="disc">{{ obj.discipline }} · n={{ obj.n }}{% if obj.note %} · {{ obj.note }}{% endif %}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Status distribution</h2>
  <table>
    <thead><tr><th>Status</th><th>Count</th><th>Share of {{ metrics.n_entries }}</th></tr></thead>
    <tbody>
      {% for row in status_rows %}
      <tr>
        <td><span class="status {{ row.status }}">{{ row.status }}</span></td>
        <td class="num">{{ row.count }}</td>
        <td class="num">{{ row.count }} / {{ metrics.n_entries }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Ledger by axis</h2>
  {% for axis, items in grouped %}
  <h3>{{ axis }} · {{ items|length }}</h3>
  {% for entry in items %}
  <article class="entry">
    <div class="entry-head">
      <span class="status {{ entry.status }}">{{ entry.status }}</span>
      {% if entry.subtype %}<span class="muted">{{ entry.subtype }}</span>{% endif %}
      <span class="doc">{{ entry.source_doc_id }}</span>
    </div>
    <div class="pair">
      <div>
        <h4>Source assumption</h4>
        <p>{{ entry.source_assumption }}</p>
      </div>
      <div>
        <h4>Target restatement</h4>
        <p>{{ entry.target_restatement or "—" }}</p>
      </div>
    </div>
    {% if entry.what_would_resolve_it %}
    <div class="ask-block">
      <h4>Ask</h4>
      <p>{{ entry.what_would_resolve_it }}</p>
    </div>
    {% endif %}
    <p class="meta">{{ entry.source_doc_id }} · evidence {{ entry.evidence_lines or "not cited" }}</p>
  </article>
  {% endfor %}
  {% endfor %}
</main>
</body>
</html>
